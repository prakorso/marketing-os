# Supabase
# Local dev defaults match `supabase start` output. Never commit real values —
# this file is a template only (see .env.local, which is gitignored).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never reference this outside server-only code (route handlers,
# server components, job workers). Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Application
# Base URL used to construct Supabase Auth redirect links (magic link, OAuth callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Not yet consumed by any code in MVP-0 Foundation. Reserved for later MVPs. ---

# OpenAI (MVP-1 Content — AI generation)
OPENAI_API_KEY=

# Social Platforms (MVP-2 Distribution — OAuth app credentials only;
# per-workspace access/refresh tokens are stored in Supabase Vault, never here)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
